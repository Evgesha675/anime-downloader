{
  "manifest_version": 3,
  "name": "AnimeLib Downloader",
  "version": "1.3.0",
  "description": "Скачивание аниме с AnimeLib с выбором озвучки и разрешения",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.cdnlibs.org/*",
    "https://*.cdnlibs.org/*",
    "https://animelib.org/*",
    "https://*.animelib.org/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://animelib.org/*", "*://*.animelib.org/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://animelib.org/*", "*://*.animelib.org/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AnimeLib Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "animelib-downloader@local",
      "strict_min_version": "128.0"
    }
  }
}
